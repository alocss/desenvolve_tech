{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [".claude/**"],
  "ignoreBinaries": ["lhci"],
  "workspaces": {
    "frontend": {
      "entry": [
        "src/app/**/{page,layout,loading,error,not-found,route}.tsx",
        "src/components/ui/**/*.tsx",
        "src/lib/utils.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
      "ignoreDependencies": [
        "tailwindcss",
        "@vitest/coverage-v8",
        "shadcn",
        "tw-animate-css",
        "@lhci/cli"
      ]
    },
    "backend": {
      "entry": ["src/main.ts", "test/**/*.e2e-spec.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@types/express"]
    }
  }
}
